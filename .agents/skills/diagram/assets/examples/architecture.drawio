<mxfile host="drawio">
  <diagram id="architecture" name="Architecture example">
    <mxGraphModel background="#FFFFFF" grid="1" gridSize="10" page="0" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Architecture 0001: storefront&lt;/b&gt;&lt;br&gt;2026-01-15" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="app" value="Storefront" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=10;fontStyle=1;fontSize=12;fillColor=#F9FAFB;strokeColor=#6B7280;fontColor=#1B3139;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="250" y="70" width="560" height="320" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="Service&lt;br&gt;&lt;b&gt;api&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#6B7280&quot;&gt;services/api&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;" vertex="1" parent="app">
          <mxGeometry x="50" y="60" width="150" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="worker" value="Service&lt;br&gt;&lt;b&gt;worker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#6B7280&quot;&gt;services/worker&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;" vertex="1" parent="app">
          <mxGeometry x="50" y="210" width="150" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="db" value="PostgreSQL&lt;br&gt;&lt;b&gt;orders&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fontSize=11;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;" vertex="1" parent="app">
          <mxGeometry x="370" y="125" width="130" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="client" value="Web client" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="130" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="scheduler" value="Scheduler&lt;br&gt;&lt;b&gt;nightly-export&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="290" width="130" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1.5;fontColor=#232F3E;" edge="1" parent="1" source="client" target="api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#F9FAFB;strokeColor=#232F3E;strokeWidth=1.5;fontColor=#232F3E;entryX=0;entryY=0.3;" edge="1" parent="1" source="api" target="db">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#F9FAFB;strokeColor=#232F3E;strokeWidth=1.5;fontColor=#232F3E;entryX=0;entryY=0.7;" edge="1" parent="1" source="worker" target="db">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="02:00 daily" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#E7157B;fontColor=#232F3E;" edge="1" parent="1" source="scheduler" target="worker">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="legend-data" value="Data flow" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;align=left;labelPosition=right;verticalAlign=middle;labelBackgroundColor=none;" edge="1" parent="1">
          <mxGeometry x="1" relative="1" as="geometry">
            <mxPoint x="40" y="420" as="sourcePoint"/>
            <mxPoint x="90" y="420" as="targetPoint"/>
            <mxPoint x="8" as="offset"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="legend-control" value="Control: a trigger, a schedule" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;strokeColor=#E7157B;fontSize=10;fontColor=#232F3E;align=left;labelBackgroundColor=none;" edge="1" parent="1">
          <mxGeometry x="1" relative="1" as="geometry">
            <mxPoint x="40" y="445" as="sourcePoint"/>
            <mxPoint x="90" y="445" as="targetPoint"/>
            <mxPoint x="8" as="offset"/>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
