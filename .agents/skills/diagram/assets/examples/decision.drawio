<mxfile host="drawio">
  <diagram id="decision" name="Decision example">
    <mxGraphModel background="#FFFFFF" grid="1" gridSize="10" page="0" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Decision refund-routing 0001: how a refund request is handled&lt;/b&gt;&lt;br&gt;2026-01-15" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="480" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="start" value="Refund request" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=11;fillColor=#232F3E;strokeColor=#232F3E;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="110" y="70" width="140" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="q1" value="Order delivered?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="90" y="150" width="180" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="q2" value="Within 30 days&lt;br&gt;of delivery?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="90" y="290" width="180" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="q3" value="Amount over 500?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="90" y="430" width="180" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="o1" value="Cancel the order,&lt;br&gt;refund in full" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F0F7FF;strokeColor=#2088FF;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="380" y="170" width="170" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="o2" value="Reject,&lt;br&gt;explain the policy" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F0F7FF;strokeColor=#2088FF;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="380" y="310" width="170" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="o3" value="Send to manual review" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F0F7FF;strokeColor=#2088FF;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="380" y="450" width="170" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="o4" value="Refund automatically" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F0F7FF;strokeColor=#2088FF;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="95" y="570" width="170" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;" edge="1" parent="1" source="start" target="q1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e1n" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#232F3E;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="q1" target="o1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e1y" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#232F3E;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="q1" target="q2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2n" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#232F3E;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="q2" target="o2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2y" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#232F3E;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="q2" target="q3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3y" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#232F3E;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="q3" target="o3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3n" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#232F3E;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="q3" target="o4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
