        <mxCell id="cluster" value="&amp;laquo;node&amp;raquo;&lt;br&gt;Kubernetes cluster" style="verticalAlign=top;align=left;shape=cube;size=10;html=1;boundedLbl=1;spacingLeft=5;whiteSpace=wrap;fontSize=11;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;container=1;collapsible=0;" vertex="1" parent="env">
          <mxGeometry x="30" y="50" width="250" height="320" as="geometry"/>
