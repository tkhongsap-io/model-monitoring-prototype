        <mxCell id="browser" value="&amp;laquo;device&amp;raquo;&lt;br&gt;Customer's browser" style="verticalAlign=top;align=left;shape=cube;size=10;html=1;boundedLbl=1;spacingLeft=5;whiteSpace=wrap;fontSize=11;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="140" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="HTTPS 443" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#232F3E;strokeWidth=1.5;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="browser" target="api">
          <mxGeometry relative="1" as="geometry"/>
