        </mxCell>
        <mxCell id="worker" value="&amp;laquo;artifact&amp;raquo;&lt;br&gt;&lt;b&gt;worker&lt;/b&gt;&lt;br&gt;1 replica" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F3F4F6;strokeColor=#232F3E;fontColor=#232F3E;" vertex="1" parent="cluster">
