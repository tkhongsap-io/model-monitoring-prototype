        <mxCell id="e2" value="TCP 5432" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#232F3E;strokeWidth=1.5;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.25;entryX=0;entryY=0.35;" edge="1" parent="1" source="api" target="db">
