        <mxCell id="bucket" value="&amp;laquo;node&amp;raquo;&lt;br&gt;Object storage&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#6B7280&quot;&gt;invoices&lt;/font&gt;" style="verticalAlign=top;align=left;shape=cube;size=10;html=1;boundedLbl=1;spacingLeft=5;whiteSpace=wrap;fontSize=11;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;" vertex="1" parent="env">
          <mxGeometry x="420" y="260" width="170" height="80" as="geometry"/>
