<mxfile host="drawio">
  <diagram id="workflow" name="Workflow example">
    <mxGraphModel background="#FFFFFF" grid="1" gridSize="10" page="0" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Workflow 0001: placing an order&lt;/b&gt;&lt;br&gt;2026-01-15" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="lane-customer" value="Customer" style="swimlane;horizontal=0;startSize=30;html=1;fillColor=#F5F5F5;strokeColor=#9CA3AF;fontStyle=1;fontSize=11;fontColor=#232F3E;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="70" width="860" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="(1) Submit the order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=11;fontColor=#232F3E;" vertex="1" parent="lane-customer">
          <mxGeometry x="60" y="30" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="s5" value="(5) Receive confirmation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=11;fontColor=#232F3E;" vertex="1" parent="lane-customer">
          <mxGeometry x="690" y="30" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="lane-api" value="api" style="swimlane;horizontal=0;startSize=30;html=1;fillColor=#F5F5F5;strokeColor=#9CA3AF;fontStyle=1;fontSize=11;fontColor=#232F3E;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="180" width="860" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="(2) Validate the order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=11;fontColor=#232F3E;" vertex="1" parent="lane-api">
          <mxGeometry x="60" y="50" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="d1" value="In stock?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=11;fontColor=#232F3E;" vertex="1" parent="lane-api">
          <mxGeometry x="260" y="35" width="120" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="(3) Reserve stock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=11;fontColor=#232F3E;" vertex="1" parent="lane-api">
          <mxGeometry x="450" y="50" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="store" value="orders" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=8;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=11;fontColor=#232F3E;" vertex="1" parent="lane-api">
          <mxGeometry x="715" y="40" width="90" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2d" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;" edge="1" parent="1" source="s2" target="d1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ed3" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d1" target="s3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3s" value="(4) write" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s3" target="store">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="es5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;" edge="1" parent="1" source="store" target="s5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
