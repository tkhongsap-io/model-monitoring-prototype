# model-monitoring-prototype — environment (copy to .env; ALL optional).
# The baked DEMO-FULL demo runs with an empty .env (zero keys, zero network).
# NEVER put real True customer/employee data or committed secrets here — .env is gitignored.

# --- core ---
DEMO_SEED=42
RAI_DEFAULT_SCENARIO=DEMO-FULL

# --- engine adapters (seeded defaults; the baker pins these regardless of env) ---
LLM_EVAL_ADAPTER=langfuse_stub
ML_MONITOR_ADAPTER=evidently_nannyml
EXPLAIN_ADAPTER=lime_shap

# --- live monitoring: the monitor PULLS telemetry from the external model apps.
# Base URLs are operator-configured (localhost in dev). The live path is exercised
# only via POST /api/live/tick?uc=... — the baked demo is unaffected.
LIVE_CHURN_URL=http://127.0.0.1:8083
LIVE_CHATBOT_URL=http://127.0.0.1:8082
LIVE_POLL_SECONDS=0

# --- real LLM-as-judge (Stage 3) ---
# Blank ANTHROPIC_API_KEY = deterministic OFFLINE heuristic judge (free, default).
# Set it to enable the real claude-opus-4-8 judge on each pulled trace — this is ONE
# API call PER TRACE, so a live LLM tick costs ~(traces/tick) opus calls. Lower the
# chatbot's RAI_CHAT_REPS (ai-use-cases) to shrink the window and keep cost/latency down.
ANTHROPIC_API_KEY=
LLM_JUDGE_MODEL=claude-opus-4-8

# --- optional Langfuse (trace side-channel; SQLite is the source of truth) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
