# AI Use Case Observability Control Tower — environment
#
# ALL variables here are OPTIONAL. The demo runs end-to-end with an empty .env:
# zero API keys, zero outbound network calls (the Langfuse stub is the default
# LLMEvalAdapter implementation and persists traces/scores to SQLite). See
# docs/PRD.md §6.9 / R-11 / R-12 / R-30 / Appendix E §E.4 / NF1.
#
# Copy this file to `.env` and fill in only what you need — NEVER commit real
# keys (.env is gitignored; only .env.example is tracked).

# --- Langfuse Cloud (optional) ---
# Only needed if you want LLM traces/scores pushed to a real Langfuse Cloud
# project instead of the local SQLite-backed stub. Create a free project at
# https://cloud.langfuse.com, then paste its keys below and set
# LLM_EVAL_ADAPTER=langfuse_cloud. Leave all three blank to stay on the stub
# (identical behaviour, no network, no account needed).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Adapter selection (env-var flips; no code changes) ---
# Each protocol has exactly one demo implementation registered today; the
# names below are what Appendix E's factory reads to select it.
LLM_EVAL_ADAPTER=langfuse_stub
ML_MONITOR_ADAPTER=evidently_nannyml
EXPLAIN_ADAPTER=lime_shap

# --- Simulation ---
# Default seed for deterministic scenario generation + bake/reset reproducibility.
DEMO_SEED=42

# NOTE: there is deliberately no OPENAI_API_KEY / live-LLM setting. The LLM
# judge is a deterministic seeded simulation (count-based hallucination
# injection + seeded score draws) — see PRD ADR-2. A live-LLM judge is a
# Deferred Capability that returns at pilot stage behind LLMEvalAdapter.
