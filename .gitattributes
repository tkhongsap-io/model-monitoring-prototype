# Replit and production run on Linux. Keep source and deployment files on LF so
# Windows tooling cannot create false whole-file diffs or break shell scripts.
* text=auto

*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.conf text eol=lf
*.example text eol=lf
*.env text eol=lf

# Diagram versions and icons (S3-08b): the icon check compares SHA-256, so keep LF everywhere.
docs/diagram/**/*.svg text eol=lf
