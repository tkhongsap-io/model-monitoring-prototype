# RAI monitoring prototype — environment.
# The prototype reads the repo-root .env first, then this tool-local .env (if present).
# OPENAI_API_KEY is already wired in the repo-root .env; the LANGFUSE_* keys are new.
# Copy to `.env` and fill in — NEVER commit real keys (.env is gitignored).

# --- LLM lane (optional) ---
# Without OPENAI_API_KEY the LLM lane runs a deterministic OFFLINE simulation, so the
# control tower still demos end-to-end with no network and no cost.
OPENAI_API_KEY=
RAI_CHAT_MODEL=gpt-4o-mini
RAI_JUDGE_MODEL=gpt-4o-mini

# --- Langfuse Cloud (optional; free tier) ---
# Create a free project at https://cloud.langfuse.com, then paste the keys here to push
# chatbot traces + eval scores. Leave blank to skip Langfuse (metrics still computed locally).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
