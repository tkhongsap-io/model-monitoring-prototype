# Replit config — Control Tower demo, both services in ONE Reserved VM:
#   Next.js  (0.0.0.0:$PORT, exposed)  --rewrites /api/*-->  uvicorn (127.0.0.1:8000, internal)
# Reserved VM (deploymentTarget = "gce") is REQUIRED: the scenario player + SSE
# subscribers live in process memory, so the app must be a single always-on
# instance — Autoscale (scale-to-zero, N stateless replicas) would break it.
# When publishing, visually confirm "Reserved VM" is selected in the Deploy pane.

modules = ["python-3.12", "nodejs-20"]

# Workspace Run button (dev preview). First time: run `bash scripts/replit_build.sh`
# in the Shell once, so .venv / the baked DB / .next exist.
run = "bash scripts/replit_start.sh"

[nix]
channel = "stable-24_05"

[env]
MPLBACKEND = "Agg"   # headless matplotlib for bake-time artifacts

[deployment]
deploymentTarget = "gce"
build = ["bash", "scripts/replit_build.sh"]
run = ["bash", "scripts/replit_start.sh"]

[[ports]]
localPort = 3000
externalPort = 80

# NOTE: port 8000 (uvicorn) is deliberately NOT declared — it binds 127.0.0.1
# only and must stay internal; the UI reaches it via the Next.js /api rewrite.
