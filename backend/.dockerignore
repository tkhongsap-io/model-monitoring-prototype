# Keep the build context lean and the image reproducible.
# NOTE: scenarios/ and seeds/ are REQUIRED by the bake — do not ignore them.

# Windows/local virtualenv (wrong platform, huge)
.venv/
venv/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/

# Prebaked/generated state — the image bakes these fresh at build time
control_tower.db
*.db
*.sqlite3
artifacts/

# Tests aren't needed to serve the demo
tests/

# Deploy metadata (not needed inside the image)
fly.toml
.dockerignore
Dockerfile
