# Template for /opt/model-monitor/backend.env on the test host (S1-04). Names only.
# The real file is made on the VM, has mode 600, and is never committed.
#
# monitor_backend user (S1-11) of Cloud SQL sandbox-pg17-db, private IP, TLS with the server CA:
DATABASE_URL=postgresql://monitor_backend:<password>@<cloud-sql-private-ip>:5432/monitor?sslmode=verify-ca&sslrootcert=/etc/model-monitor/cloudsql-server-ca.pem
#
# USE_CASE_ID:<sha256 of the API key>, comma-separated. Only hashes, never a key.
# The plain key is in Secret Manager for the GCP job (S1-03).
BATCH_API_KEY_SHA256=
